# Serve the matching .html file for clean URLs (e.g. /about -> about.html),
# required because Next.js static export creates a folder per route for its
# internal navigation payload, which would otherwise shadow the real page.

# Disable Apache's automatic trailing-slash redirect for directories --
# it conflicts with the rewrite below and causes an infinite redirect loop.
DirectorySlash Off

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Internally strip a trailing slash (no redirect, just for matching below)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^(.+)/$ /$1 [L]

  # If the exact path isn't a real file, but path.html is, serve that
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.*)$ $1.html [L]
</IfModule>

# Custom 404 page
ErrorDocument 404 /404.html

# Cache static assets aggressively (filenames are content-hashed by Next.js)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
</IfModule>
